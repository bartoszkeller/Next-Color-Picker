{
  "manifest_version": 3,
  "name": "Next Color Picker",
  "version": "1.0.0",
  "author": "Bartosz Keller",
  "homepage_url": "https://bartoszkeller.dev",
  "description": "Minimal color picker: a magnifier follows your cursor, click to copy the HEX, Esc to cancel.",
  "minimum_chrome_version": "99",
  "permissions": ["activeTab", "scripting", "declarativeContent"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Next Color Picker",
    "default_icon": {
      "16": "icons/icon16-blocked.png",
      "32": "icons/icon32-blocked.png",
      "48": "icons/icon48-blocked.png",
      "128": "icons/icon128-blocked.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
